# Copy to contracts/.env (gitignored). TESTNET-ONLY throwaway keys; never put a mainnet key here.
# Principal: deploys the registry, grants and revokes warrants.
DEPLOYER_PRIVATE_KEY=0x...
DEPLOYER_ADDRESS=0x...
# Agent: signs attestPreflight. Must be the address the warrant is granted to.
AGENT_PRIVATE_KEY=0x...
AGENT_ADDRESS=0x...
